# language is case-insensitive

# <<- means bring in file name, not just string
asm <<- "bootloader.asm"
abm <<- "kernel_init.abm"
abm <<- "graphics.abm"

# can be float or int too
xmm0 float
xmm0 = 5, 6, 7, 8

# will leave the fourth one as 0
xmm1 int
xmm1 = 9, 10, 11

# can only be int
ecx int

# for loops
for ecx = 0, ecx > 7, ecx++ {

        # this will pratt parse and then add 253 to the first number in xmm0
        xmm0[0] += 55 + 6 * 33

        # this will not be allowed because of the types, compiler error
        xmm0 += xmm1

        # casts this properly while retaining the actual values of the numbers
        xmm1 to xmm2 float

        # this would work after the cast
        xmm0 += xmm2

        # this will shuffle xmm0 positions
        xmm0 shuffle 0, 1, 3, 0

        # this will work fine because they're both ints
        xmm1[2] += eax
}

# this is how you use the stack
stack[0] int

# the types match so you can do this
stack[0] = 55 + ecx

# if statements
if stack[0] >= xmm1[1] && ecx == 6 {

        # will go into xmm3[0]
        ecx to xmm3 float
}


