# stuff to know about the abstram language:
# it is case insensitive
# every type is 32 bits
# data in memory doesn't have types
# every register is global

# it uses an interesting type system
# every register is statically typed,
# until it is cast to another type in a
# conditional branch
# after that it becomes dynamically typed
# (for only the rest of the program after the branch merge)
#
# a potential problem here, if a dynamically typed reg is
# moved to another reg, won't the other reg also become
# dynamically typed
#
# nope! when a dynamic reg is moved to a static reg,
# the compiler automatically inserts a check to see if 
# they are already the same type. iff they arent the same
# type, then it switches the the other reg to be dynamic
#
# in loops, if a reg is cast to another type inside a loop
# it will make two versions of the loop, one with static
# typing, the other with dynamic typing. the first one will be
# used first, the second one will be used the rest of the time
#
# if you cast a reg and then uncast it in the same loop with
# each instruction having the same condition, it stays static


# bootloader and multi-core and graphics setup and stack init
# the stack is restricted to only being used by the compiler
# but can be accessed via assembly insertions
#

run runtime.init

# init general memory field
field: alloc compiler.int_calculator {1 * 1000 * 1000 * 1000}

# insert assembly
compiler.assembly <- "; example assembly code (comment)"

# can be float
xmm0: float
xmm0 = 5, 6, 7, compiler.float_calculator {-(1 / 7)}

# or int too
xmm1: int
xmm1 = 9, 10, 11, 0

# can only be int
ecx: int

while runtime.calculator{ecx > 1}
  ecx dec
end

# repeat loops
repeat ecx 7

        # xmm0_s is the first element of xmm0
        # this won't compile because ecx and xmm0_s are different types
        xmm0_s += runtime.calculator{55 + 6 * ecx}
        
        xmm0 -> xmm3: int


        # this will not be allowed because of the types, compiler error
        xmm0 += xmm1

        # casts this properly while retaining the actual values of the numbers
        xmm1 -> xmm2: float

        # this would work after the cast
        xmm0 += xmm2

        # this will shuffle xmm0 positions
        xmm0 shuffle 0, 1, 3, 0

        # this will work fine because they're both ints
        kill xmm0
        xmm1[2] to xmm0
        xmm1 += eax
end

field[0] = 0

# multithreaded repeat loop
runtime.parallel_repeat ecx 7

        # all operations on memory here are locked
        field[0] += ecx
end


# the types match so you can do this
field[0] = runtime.calculator{55 + ecx}

# functions: everything in the list is actually discluded from the function
# and copied to other registers or field
# when the function is over they're moved back
# inlined by default
fn do_random_things : eax int, ebx int, ecx int, xmm1 int
        eax = 21
        field[0] = eax

        # moves all 4 values to field 1, 2, 3, 4
        field[1] = xmm1

end

# run the function
run do_random_things

# if statements
if runtime.calculator{field[0] >= xmm1[1] && ecx == 6}

        # will go into xmm3[0]
        ecx -> xmm3: float
end

